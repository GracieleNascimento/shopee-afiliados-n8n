# ===== MODO TESTE =====
# true = NAO publica nas redes: manda uma previa de cada post so para o seu Telegram pessoal
# (e nao marca produtos como postados). Troque para false quando estiver satisfeita.
DRY_RUN=true

# ===== OBRIGATÓRIO (preencher) =====
# Gere uma chave: openssl rand -hex 24   (ou qualquer texto longo; NÃO troque depois)
N8N_ENCRYPTION_KEY=troque-por-um-texto-longo-aleatorio

# Shopee Afiliados > Open API (affiliate.shopee.com.br > API de Afiliados)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Google AI Studio (aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram: crie o bot no @BotFather, adicione o bot como ADMIN do canal
TELEGRAM_BOT_TOKEN=
# Canal: @nomedocanal  (ou id numérico -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=
# Seu chat pessoal com o bot (relatório diário e alertas de erro). Veja o id em @userinfobot
TELEGRAM_ADMIN_CHAT_ID=

# ===== AJUSTES DA CURADORIA (pode mexer à vontade) =====
# Palavras-chave de busca, separadas por vírgula (rodam em rodízio)
SHOPEE_KEYWORDS=achadinhos casa,organizador cozinha,fone bluetooth,utilidades domesticas,skincare,suporte celular,garrafa termica,luminaria led
KEYWORDS_PER_RUN=3
POSTS_PER_RUN=3
MIN_RATING=4.6
MIN_DISCOUNT=15
MIN_COMMISSION_PCT=6
MIN_SALES=200
MAX_PRICE=300

# Estilo da legenda e aviso de afiliado
PERSONA=amiga que adora garimpar promocoes e fala de forma leve e honesta
DISCLOSURE=Link de afiliado: posso ganhar comissao sem custo extra para voce. Precos podem mudar.
# Etiqueta de rastreio nos links (aparece no relatório da Shopee)
SUBID=n8n

# ===== CANVA (arte dos posts) =====
# true = usa templates do Canva; false = usa a foto do produto como arte
CANVA_ENABLED=false
# IDs dos Brand Templates (campos do template: titulo, preco, desconto, foto)
CANVA_TEMPLATE_IG=
CANVA_TEMPLATE_PIN=
CANVA_TEMPLATE_TT=
# A autenticacao do Canva e a credencial OAuth2 do n8n (selecionada nos nos "Canva - ..." do workflow 05)

# ===== INSTAGRAM (Graph API: conta Business/Criador ligada a uma Pagina do Facebook) =====
IG_USER_ID=
IG_ACCESS_TOKEN=
# Data de vencimento do token (AAAA-MM-DD) para o aviso antecipado
IG_TOKEN_EXPIRES=
# Link da sua bio (Linktree etc.), citado nas legendas. Pode ficar vazio.
BIO_LINK=

# ===== PINTEREST (API v5) =====
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_TOKEN_EXPIRES=

# ===== TIKTOK (opcional; sem isso cai na fila manual no seu Telegram) =====
TIKTOK_ACCESS_TOKEN=
