{
  "id": "shopeeCanva05",
  "name": "05 - Canva gerar arte",
  "nodes": [
    {
      "id": "n20-b95e20",
      "name": "Receber item",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "n21-3063d2",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const t = { ig: $env.CANVA_TEMPLATE_IG, pin: $env.CANVA_TEMPLATE_PIN, tt: $env.CANVA_TEMPLATE_TT }[$json.canal];\nreturn [{ json: { ...$json, templateId: t || '', canvaOn: ($env.CANVA_ENABLED === 'true' && !!t) ? 'sim' : 'nao' } }];"
      }
    },
    {
      "id": "n22-59474f",
      "name": "Canva ligado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.canvaOn }}",
              "operation": "equals",
              "value2": "sim"
            }
          ]
        }
      }
    },
    {
      "id": "n23-bbccfd",
      "name": "Sem Canva - usar foto do produto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "jsCode": "return [{ json: { ...$json, artUrl: $json.imagem } }];"
      }
    },
    {
      "id": "n24-f249ea",
      "name": "Canva - enviar foto do produto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/url-asset-uploads",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'shopee-' + $json.itemId, url: $json.imagem }) }}",
        "options": {}
      }
    },
    {
      "id": "n25-224f34",
      "name": "Aguardar upload",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        -100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 4,
        "unit": "seconds"
      },
      "webhookId": "wa3bf2dd4"
    },
    {
      "id": "n26-eed78a",
      "name": "Canva - status do upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.canva.com/rest/v1/url-asset-uploads/{{ $json.job.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      }
    },
    {
      "id": "n27-f4c232",
      "name": "Upload em andamento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1480,
        -100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.job.status }}",
              "operation": "equals",
              "value2": "in_progress"
            }
          ]
        }
      }
    },
    {
      "id": "n28-42432c",
      "name": "Canva - preencher template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1740,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/autofills",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brand_template_id: $('Preparar').first().json.templateId, data: { titulo: { type: 'text', text: $('Preparar').first().json.titulo }, preco: { type: 'text', text: $('Preparar').first().json.precoTxt }, desconto: { type: 'text', text: $('Preparar').first().json.descTxt.trim() || ' ' }, foto: { type: 'image', asset_id: $json.job.asset.id } } }) }}",
        "options": {}
      }
    },
    {
      "id": "n29-89dfd5",
      "name": "Aguardar autofill",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      },
      "webhookId": "w3b34f71b"
    },
    {
      "id": "n30-be562a",
      "name": "Canva - status do autofill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.canva.com/rest/v1/autofills/{{ $json.job.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      }
    },
    {
      "id": "n31-5381c6",
      "name": "Autofill em andamento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2480,
        -100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.job.status }}",
              "operation": "equals",
              "value2": "in_progress"
            }
          ]
        }
      }
    },
    {
      "id": "n32-e96e1a",
      "name": "Canva - exportar JPG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2740,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/exports",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ design_id: $json.job.result.design.id, format: { type: 'jpg', quality: 90 } }) }}",
        "options": {}
      }
    },
    {
      "id": "n33-fef4a0",
      "name": "Aguardar exportacao",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3000,
        -100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      },
      "webhookId": "w3d30c30f"
    },
    {
      "id": "n34-978666",
      "name": "Canva - status da exportacao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3240,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.canva.com/rest/v1/exports/{{ $json.job.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      }
    },
    {
      "id": "n35-b47951",
      "name": "Exportacao em andamento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        3480,
        -100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.job.status }}",
              "operation": "equals",
              "value2": "in_progress"
            }
          ]
        }
      }
    },
    {
      "id": "n36-a1c0fb",
      "name": "Resultado - URL da arte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        -100
      ],
      "parameters": {
        "jsCode": "const base = $('Preparar').first().json;\nconst urls = ($json.job && $json.job.urls) || [];\nif (!urls.length) throw new Error('Canva nao devolveu a arte: ' + JSON.stringify($json.job));\nreturn [{ json: { ...base, artUrl: urls[0] } }];"
      }
    },
    {
      "id": "n37-d619d3",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -300
      ],
      "parameters": {
        "content": "## 05 - Arte no Canva (sub-workflow)\nFluxo: envia a foto do produto ao Canva > preenche o template de marca (campos: titulo, preco, desconto, foto) > exporta JPG > devolve artUrl.\nSelecione SUA credencial OAuth2 do Canva nos 7 nos \"Canva - ...\". Se CANVA_ENABLED nao for true, usa a foto do produto.",
        "width": 700,
        "height": 200
      }
    }
  ],
